{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"noEmit": true,
		"isolatedModules": true,
		"strict": true,
		"skipLibCheck": true
	},
	"include": ["src"]
}
