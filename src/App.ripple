    <div class="app-container">
        <nav class="nav">
            <button class="link-btn" onClick={() => { location.hash = '/' }}>{"Home"}</button>
            <button class="link-btn" onClick={() => { location.hash = '/login' }}>{"Login"}</button>
        </nav>

        <div id="route-outlet" class="route-outlet"></div>

        <style>
            .app-container { padding: 16px; }
